[Unit]
Description=Forge local automation scheduler
After=network-online.target owui-swarm-personal.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/openwebui-codex-swarm
EnvironmentFile=%h/.config/owui-swarm/environment
ExecStart=%h/openwebui-codex-swarm/.venv/bin/owui-swarm --config %h/.config/owui-swarm/config.toml scheduler run
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/owui-swarm

[Install]
WantedBy=default.target
