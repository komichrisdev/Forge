{
  "name": "owui-swarm-chatgpt-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20.19" },
  "scripts": {
    "build": "npm run build:mcp",
    "build:mcp": "tsc -p tsconfig.server.json && vite build",
    "check:mcp-build": "node scripts/mcp-build.mjs check",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "test:mcp-contract": "node --test --import tsx test/swarm-control.test.ts",
    "test:mcp-parity": "node scripts/mcp-build.mjs parity",
    "serve": "node build/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.11.1",
    "express": "5.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "1.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.3",
    "@types/node": "20.19.9",
    "tsx": "4.20.6",
    "typescript": "5.8.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  }
}
